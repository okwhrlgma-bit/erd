#!/bin/sh
# 커밋 메시지 MSYS 경로 오염 차단 (2026-08-28 self-강화 · 같은 사고 2회 재발로 기계화)
#
# Git Bash 에서 git commit -m "/apps ..." 처럼 슬래시로 시작하는 인자는 MSYS 가
# "C:/Program Files/Git/apps ..." 로 바꿔치기한다. 메모리에 두 번 적었는데 두 번 다 재발했다.
# 기록은 재발을 못 막는다 — 그래서 여기서 기계로 막는다.
#
# 올바른 우회: MSYS_NO_PATHCONV=1 git commit -m "/apps ..."  또는 메시지를 heredoc 으로.
if grep -q "C:/Program Files/Git" "$1"; then
  echo "[commit-msg] X 메시지에 MSYS 경로 오염 감지 (C:/Program Files/Git...)"
  echo "  슬래시로 시작한 -m 인자가 경로로 변환된 것이다. 이렇게 커밋하라:"
  echo "    MSYS_NO_PATHCONV=1 git commit -m \"/apps ...\""
  exit 1
fi
exit 0
